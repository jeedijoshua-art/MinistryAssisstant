# APPLICATION
APP_ENV=development
APP_DEBUG=True
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# DATABASE
# Format: postgresql+asyncpg://user:password@host/database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/ztp_db

# JWT
JWT_SECRET=replace_with_secure_random_secret

# AI
GEMINI_API_KEY=your_gemini_api_key_here

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# IMAGE PROVIDER (pollinations, openai, huggingface, fal, stability, replicate)
IMAGE_PROVIDER=pollinations
